{
  "name": "ferramenta-family",
  "version": "2.1.0",
  "description": "The Ferramenta family: registry, shared site chrome, landing kit, icons, design tokens, textures, and the display font",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ferramenta.git",
    "directory": "packages/family"
  },
  "files": [
    "dist",
    "fonts",
    "icons",
    "src",
    "styles",
    "textures",
    "NOTICE.md",
    "README.md",
    "markdown"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/family.d.ts",
      "default": "./dist/family.js"
    },
    "./chrome.css": "./styles/chrome.css",
    "./docs.css": "./styles/docs.css",
    "./fonts.css": "./styles/fonts.css",
    "./landing.css": "./styles/landing.css",
    "./theme.css": "./styles/theme.css",
    "./tokens.css": "./styles/tokens.css",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./textures/*": "./textures/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
