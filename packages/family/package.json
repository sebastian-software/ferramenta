{
  "name": "ferramenta-family",
  "version": "2.0.0",
  "description": "The Ferramenta family: the registry, the Monografie page system, the members' marks and instruments, and the README frames",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ferramenta.git",
    "directory": "packages/family"
  },
  "files": [
    "dist",
    "icons",
    "src",
    "styles",
    "NOTICE.md",
    "README.md",
    "markdown",
    "ferra"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/family.d.ts",
      "default": "./dist/family.js"
    },
    "./icons/*": "./icons/*",
    "./package.json": "./package.json",
    "./ferra-assets/*": "./ferra/*",
    "./monografie": {
      "types": "./dist/monografie.d.ts",
      "default": "./dist/monografie.js"
    },
    "./monografie.css": "./styles/monografie.css",
    "./monografie-docs.css": "./styles/monografie-docs.css",
    "./monografie-ardo.css": "./styles/monografie-ardo.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
