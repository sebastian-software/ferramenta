{
  "palette": {
    "paper": "#F4F0E6",
    "reading": "#FBFAF6",
    "pewter": "#DCDDD6",
    "ink": "#29362F",
    "muted": "#5C655B",
    "oxide": "#88492F",
    "white": "#FFFFFF"
  },
  "roles": {
    "background": "var(--ferra-paper)",
    "surface": "var(--ferra-reading)",
    "text": "var(--ferra-ink)",
    "text-secondary": "var(--ferra-muted)",
    "accent": "var(--ferra-oxide)",
    "on-accent": "var(--ferra-reading)",
    "border": "color-mix(in srgb, var(--ferra-ink) 22%, var(--ferra-paper))",
    "accent-hover": "color-mix(in srgb, var(--ferra-oxide) 85%, var(--ferra-ink))",
    "editorial-background": "color-mix(in srgb, var(--ferra-reading) 72%, var(--ferra-pewter))",
    "selected": "color-mix(in srgb, var(--ferra-accent) 7%, var(--ferra-surface))",
    "card-surface": "color-mix(in srgb, var(--ferra-white) 40%, var(--ferra-reading))",
    "card-footer": "color-mix(in srgb, var(--ferra-pewter) 32%, var(--ferra-card-surface))",
    "card-edge": "color-mix(in srgb, var(--ferra-ink) 8%, transparent)",
    "card-shadow": "color-mix(in srgb, var(--ferra-ink) 5%, transparent)"
  },
  "type": {
    "font-sans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "font-display": "\"IBM Plex Sans\", system-ui, sans-serif",
    "font-mono": "ui-monospace, \"SFMono-Regular\", Consolas, monospace",
    "text-small": "0.875rem",
    "text-body": "1.0625rem",
    "text-lead": "1.125rem",
    "text-title": "1.5625rem",
    "text-heading": "clamp(1.875rem, 3.2vw, 2.6875rem)",
    "text-display": "clamp(2.625rem, 7.3vw, 6rem)",
    "leading-body": "1.7",
    "leading-heading": "1.13",
    "text-editorial-display": "clamp(2rem, 3.4vw, 3.25rem)",
    "text-editorial-title": "clamp(1.875rem, 2.6vw, 2.625rem)"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "18": "4.5rem",
    "24": "6rem",
    "32": "8rem"
  },
  "layout": {
    "width": "86rem",
    "gutter": "clamp(1.5rem, 4.5vw, 4.25rem)",
    "margin-width": "10.5rem",
    "column-gap": "clamp(2.625rem, 5vw, 4.5rem)",
    "section-gap": "clamp(5.5rem, 9vw, 8rem)",
    "measure": "68ch",
    "radius": "0.1875rem",
    "target": "2.75rem",
    "card-radius": "1.25rem",
    "card-padding": "clamp(0.75rem, 2.4vw, 2.25rem)",
    "editorial-gap": "clamp(1rem, 1.6vw, 1.5rem)"
  }
}
