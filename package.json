{
  "name": "ferramenta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm build:package && react-router build",
    "build:package": "pnpm --filter @ferramenta/family build",
    "prepare": "pnpm build:package",
    "preview": "vite preview",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "readme:check": "node packages/family/bin/family-readme.mjs --check README.md",
    "readme:write": "node packages/family/bin/family-readme.mjs --write README.md",
    "test": "node --test \"scripts/**/*.test.mjs\" \"packages/*/test/**/*.test.mjs\" && pnpm readme:check",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "stats:refresh": "node scripts/refresh-registry-stats.mjs"
  },
  "dependencies": {
    "@ferramenta/family": "workspace:*",
    "ardo": "^4.2.0",
    "isbot": "^5.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.0.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.10.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "packageManager": "pnpm@11.10.0"
}
