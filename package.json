{
  "name": "ferramenta",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm build:package && react-router build && node scripts/check-rendered-links.mjs",
    "build:package": "pnpm --filter ferramenta-family build",
    "prepare": "pnpm build:package",
    "preview": "vite preview",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check:markdown-links": "node scripts/check-markdown-links.mjs",
    "readme:check": "node packages/family/bin/family-readme.mjs --check README.md.src && mise run readme:check",
    "readme:write": "node packages/family/bin/family-readme.mjs --write README.md.src && mise run readme:write",
    "test": "node --test \"scripts/**/*.test.mjs\" \"packages/*/test/**/*.test.mjs\" && pnpm readme:check && pnpm check:markdown-links && pnpm theme:check",
    "verify:package": "node scripts/verify-package-consumers.mjs",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "stats:refresh": "node scripts/refresh-registry-stats.mjs",
    "theme:write": "node scripts/native-theme.mjs --write",
    "theme:check": "node scripts/native-theme.mjs --check"
  },
  "dependencies": {
    "ardo": "^4.2.0",
    "ferramenta-family": "workspace:*",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@sebastian-software/standards": "0.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
