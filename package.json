{
  "name": "ferramenta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm --filter @ferramenta/ardo-config build && react-router build",
    "preview": "vite preview",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "stats:refresh": "node scripts/refresh-registry-stats.mjs"
  },
  "dependencies": {
    "@ferramenta/ardo-config": "workspace:*",
    "ardo": "^4.1.0",
    "isbot": "*",
    "react": "*",
    "react-dom": "*",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.0.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.10.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0-beta.0"
  },
  "packageManager": "pnpm@11.10.0"
}
