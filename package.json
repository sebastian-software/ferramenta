{
  "name": "ferramenta",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ardo dev",
    "build": "pnpm build:package && ardo build && node scripts/check-rendered-links.mjs",
    "build:package": "pnpm --filter ferramenta-family build",
    "prepare": "pnpm build:package",
    "preview": "ardo preview",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check:markdown-links": "mise run links:check",
    "readme:check": "mise run readme:check",
    "readme:write": "mise run readme:write",
    "test": "node --test \"scripts/**/*.test.mjs\" \"packages/*/test/**/*.test.mjs\" && pnpm readme:check && pnpm check:markdown-links && pnpm theme:check",
    "verify:package": "node scripts/verify-package-consumers.mjs",
    "review": "node scripts/review-site.mjs",
    "docs:ferromark": "pnpm build:package && node scripts/ferromark-docs.mjs",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "stats:refresh": "node scripts/refresh-registry-stats.mjs",
    "theme:write": "node packages/family/scripts/native-theme.mjs --write",
    "theme:check": "node packages/family/scripts/native-theme.mjs --check",
    "social:write": "node scripts/render-social.mjs"
  },
  "dependencies": {
    "ardo": "^6.0.0",
    "ferramenta-family": "workspace:*"
  },
  "devDependencies": {
    "@sebastian-software/standards": "0.13.0",
    "eslint": "^10.11.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
